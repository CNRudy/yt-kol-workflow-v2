# =============================================================================
# yt-kol-workflow 环境变量示例（复制为 .env 后填写）
# 注意：飞书 Base 的 token 统一用 FEISHU_APP_TOKEN（不是 BASE_TOKEN）。
# =============================================================================

# ---- YouTube ----
YOUTUBE_API_KEY=

# ---- 飞书（应用凭据模式，可选） ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 目标 Base 的 app_token（或 /base/<token> 链接中的 token）
FEISHU_APP_TOKEN=

# ---- 飞书鉴权模式 ----
# auto: 优先 CLI 用户身份，其次 app 凭据；cli: 仅 CLI；app: 仅应用凭据
FEISHU_AUTH_MODE=auto
# CLI 用户登录后保存的 profile 名
FEISHU_CLI_PROFILE=kol-workflow
FEISHU_AUTH_TIMEOUT_SECONDS=900
# 自动创建/授权/打开浏览器（首次配置用）
FEISHU_AUTO_SETUP=true
FEISHU_AUTO_INSTALL=true
FEISHU_OPEN_BROWSER=true

# ---- 飞书 CLI 路径与代理（新机器/服务器务必覆盖） ----
# lark-cli 可执行文件绝对路径；**留空脚本会主动报错**（不再提供作者本机默认值）
FEISHU_LARK_CLI_PATH=
# 自动安装时固定 lark-cli 版本（如 @larksuite/cli@1.2.3），避免 @latest 漂移
FEISHU_LARK_CLI_PACKAGE=
# 访问飞书/YouTube 需要的 HTTPS 代理（如 http://127.0.0.1:7890）；留空则不注入代理
FEISHU_HTTPS_PROXY=

# ---- 表 ID（必填：不填脚本会主动报错，无作者主库默认值） ----
# 派生「红人表」ID；运行 sync_hongren_table.py 时按需填入
FEISHU_HONGREN_TABLE_ID=
# 以下四个仅在用 write_user_base.py 直连既有表时按需覆盖
# FEISHU_TABLE_DETAIL=tbl<YOUR_TABLE_ID>
# FEISHU_TABLE_VIDEO=tbl<YOUR_TABLE_ID>
# FEISHU_TABLE_INFLUENCER_VIDEO=tbl<YOUR_TABLE_ID>
# FEISHU_TABLE_TASK=tbl<YOUR_TABLE_ID>

# ---- 其他 ----
# 新建 Base 时的默认名称
FEISHU_BASE_NAME=KOL网红开发工作流
